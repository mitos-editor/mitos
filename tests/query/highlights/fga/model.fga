model
#^^^^ @keyword
  schema 1.2
# ^^^^^^ @keyword
#        ^^^ @constant.numeric

type user
#    ^^^^ @type
type team
#    ^^^^ @type
  relations
# ^^^^^^^^^ @keyword
    define member: [user]
#          ^^^^^^ @variable.other.member
#                   ^^^^ @type
#                  ^ @punctuation.bracket
#                       ^ @punctuation.bracket
#                ^ @punctuation.delimiter
type folder
#    ^^^^^^ @type
  relations
    define viewer: [user, user:*, team#member with $expression]
#          ^^^^^^ @variable.other.member
#                   ^^^^ @type
#                         ^^^^^^ @type
#                                 ^^^^^^^^^^^ @type
#                                             ^^^^ @keyword.operator
#                                                  ^^^^^^^^^^^ @constant.builtin
#                       ^ @punctuation.delimiter
    define editor: viewer or (viewer and viewer)
#                  ^^^^^^ @variable.other.member
#                        ^^ @operator
#                                    ^^^ @operator
#                            ^ @punctuation.bracket
#                                              ^ @punctuation.bracket
    define owner: viewer from parent
#                 ^^^^^^ @variable.other.member
#                        ^^^^ @keyword.operator
#                             ^^^^^^ @variable.other.member
    define restricted: viewer but not editor
#                             ^^^^^^^ @operator
    define allowed: [user with check]
#                              ^^^^^ @function

condition check(value: int, other: int, enabled: bool, labels: map<string>, values: list<int>) {
#         ^^^^^ @function
#               ^^^^^ @variable.parameter
#                      ^^^ @type.builtin
#                                                              ^^^ @type.builtin
#                                                                                   ^^^^ @type.builtin
#                                                                 ^ @punctuation.bracket
#                                                                        ^ @punctuation.bracket
#              ^ @punctuation.bracket
#                                                                                            ^ @punctuation.bracket
#                                                                                              ^ @punctuation.bracket
  // A CEL comment containing } and "quotes"
# ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ @comment
  value-other > 0 && value in [0x10, 2u, 0xFFU, 1.5, .5, 1e-2]
# ^^^^^ @variable.parameter
#       ^^^^^ @variable.parameter
#      ^ @operator
#             ^ @operator
#                 ^^ @operator
#                          ^^ @operator
#                              ^^^^ @constant.numeric.integer
#                                    ^^ @constant.numeric.integer
#                                        ^^^^^ @constant.numeric.integer
#                                               ^^^ @constant.numeric.float
#                                                ^^ @constant.numeric.float
#                                                        ^^^^ @constant.numeric.float
  enabled == true && null != false
# ^^^^^^^ @variable.parameter
#            ^^^^ @constant.builtin.boolean
#                    ^^^^ @constant.builtin
#                            ^^^^^ @constant.builtin.boolean
  {"enabled": enabled}["enabled"] && (value > other)
#  ^^^^^^^^^ @string
#             ^^^^^^^ @variable.parameter
#                                     ^^^^^ @variable.parameter
#                                             ^^^^^ @variable.parameter
# ^ @punctuation.bracket
#                     ^ @punctuation.bracket
  labels.value == value && labels.contains("value") && size(values) > 0
# ^^^^^^ @variable.parameter
#        ^^^^^ @variable.other.member
#                 ^^^^^ @variable.parameter
#                                 ^^^^^^^^ @function.method
#                                                      ^^^^ @function
#                                                           ^^^^^^ @variable.parameter
#       ^ @punctuation.delimiter
  r"raw\string" != R'raw\string' && br"raw\bytes" != B'bytes'
# ^^^^^^^^^^^^^ @string
#                  ^^^^^^^^^^^^^ @string
#                                   ^^^^^^^^^^^^^ @string.special
#                                                    ^^^^^^^^ @string.special
  """triple string""" != b"""triple bytes"""
# ^^^^^^^^^^^^^^^^^^^ @string
#                        ^^^^^^^^^^^^^^^^^^^ @string.special
 }
#^ @punctuation.bracket

condition calls(size: int, contains: string, labels: map<string>) {
  size([size]) > 0 && labels.contains(contains)
# ^^^^ @function
#       ^^^^ @variable.parameter
#                    ^^^^^^ @variable.parameter
#                            ^^^^^^^^ @function.method
#                                     ^^^^^^^^ @variable.parameter
 }

condition multiline(value: string) {
  value == """first line
literal second line
final line""" && value != br"""raw bytes"""
#^^^^^^^^^^^^ @string
#                ^^^^^ @variable.parameter
#                         ^^^^^^^^^^^^^^^^^ @string.special
 }
